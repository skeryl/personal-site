# The quilt builder is published to GitHub Packages from skeryl/quilt-builder.
# This has to sit at the root: npm ignores a workspace's own .npmrc for config
# ("npm warn config ignoring workspace config at packages/ui/.npmrc").
#
# The token is not here and should not be. CI supplies it through setup-node;
# locally, put it in your own ~/.npmrc:
#   npm config set //npm.pkg.github.com/:_authToken <a read:packages PAT>
@skeryl:registry=https://npm.pkg.github.com
